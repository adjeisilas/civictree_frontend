# Copy to .env and fill in. Never commit the real .env.
#
# Vite reads these at BUILD time and writes the values into the bundle. They are
# visible to anyone who opens the site, so no secret belongs here — and changing
# one means rebuilding, not restarting.

# Where the API lives. Set this on the build machine or in the deploy platform,
# or the production bundle will be built pointing at a developer's laptop.
#   local:      http://localhost:5000/api
#   production: https://api.civictreegh.com/api
VITE_API_BASE_URL=https://api.civictreegh.com/api

# For a local override, put it in .env.local instead of editing .env — Vite reads
# .env.local first and it is gitignored, so the committed production value stays
# intact. A production build refuses to run if it resolves to a local address.

# Public key for web push. The matching private key stays on the server.
VITE_VAPID_PUBLIC_KEY=

# Support chatbot service
VITE_CHATBOT_API_URL=
